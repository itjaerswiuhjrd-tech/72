<!DOCTYPE html Large House. Features: Spacious and large house, plenty of room for furniture and items
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>CraftRealm | Minecraft Server</title>

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <!-- Bootstrap Icons -->
    <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"
    >

    <!-- Google Font -->
    <link
        href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;600;700;800;900&display=swap"
        rel="stylesheet"
    >

    <style>
        :root {
            --green: #39ff88;
            --green-dark: #13a85a;
            --cyan: #20e3ff;
            --purple: #9b5cff;
            --bg: #050807;
            --bg-2: #09100d;
            --card: rgba(14, 24, 19, 0.72);
            --border: rgba(57, 255, 136, 0.18);
            --text: #f2fff7;
            --muted: #8da095;
        }

        * {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            background:
                radial-gradient(circle at 20% 10%, rgba(57,255,136,.08), transparent 30%),
                radial-gradient(circle at 80% 30%, rgba(32,227,255,.06), transparent 25%),
                var(--bg);
            color: var(--text);
            font-family: "Orbitron", sans-serif;
            overflow-x: hidden;
        }

        /* =========================
           SCROLLBAR
        ========================= */

        ::-webkit-scrollbar {
            width: 8px;
        }

        ::-webkit-scrollbar-track {
            background: #020403;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--green);
            border-radius: 20px;
        }

        /* =========================
           NAVBAR
        ========================= */

        .navbar {
            background: rgba(3, 7, 5, .78);
            backdrop-filter: blur(18px);
            border-bottom: 1px solid rgba(57,255,136,.1);
            transition: .4s;
        }

        .navbar.scrolled {
            box-shadow: 0 0 40px rgba(57,255,136,.08);
        }

        .navbar-brand {
            color: white !important;
            font-weight: 900;
            letter-spacing: 2px;
            text-shadow:
                0 0 8px var(--green),
                0 0 20px rgba(57,255,136,.5);
        }

        .navbar-brand span {
            color: var(--green);
        }

        .nav-link {
            color: #b9c9bf !important;
            margin: 0 8px;
            transition: .3s;
            font-size: 13px;
        }

        .nav-link:hover {
            color: var(--green) !important;
            text-shadow: 0 0 12px var(--green);
        }

        /* =========================
           HERO
        ========================= */

        .hero {
            min-height: 100vh;
            position: relative;
            display: flex;
            align-items: center;
            overflow: hidden;
            background:
                linear-gradient(
                    rgba(2,7,4,.62),
                    rgba(2,7,4,.94)
                ),
                radial-gradient(
                    circle at center,
                    rgba(57,255,136,.1),
                    transparent 45%
                );
        }

        .hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background-image:
                linear-gradient(rgba(255,255,255,.018) 1px, transparent 1px),
                linear-gradient(90deg, rgba(255,255,255,.018) 1px, transparent 1px);
            background-size: 60px 60px;
            mask-image: linear-gradient(to bottom, black, transparent);
        }

        .hero-content {
            position: relative;
            z-index: 3;
        }

        .badge-server {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 15px;
            border: 1px solid rgba(57,255,136,.25);
            background: rgba(57,255,136,.06);
            border-radius: 50px;
            color: var(--green);
            font-size: 11px;
            letter-spacing: 1px;
            animation: fadeUp .8s ease both;
        }

        .online-dot {
            width: 8px;
            height: 8px;
            background: var(--green);
            border-radius: 50%;
            box-shadow: 0 0 12px var(--green);
            animation: pulse 1.5s infinite;
        }

        .hero h1 {
            font-size: clamp(48px, 8vw, 105px);
            line-height: .95;
            font-weight: 900;
            margin-top: 25px;
            letter-spacing: -4px;
            animation: fadeUp .9s .1s ease both;
        }

        .hero h1 .glow {
            color: var(--green);
            text-shadow:
                0 0 8px var(--green),
                0 0 25px rgba(57,255,136,.65),
                0 0 60px rgba(57,255,136,.3);
        }

        .hero p {
            max-width: 650px;
            color: var(--muted);
            font-family: Arial, sans-serif;
            font-size: 17px;
            line-height: 1.8;
            animation: fadeUp 1s .2s ease both;
        }

        /* =========================
           BUTTONS
        ========================= */

        .btn-main {
            position: relative;
            border: 1px solid var(--green);
            background: var(--green);
            color: #031008;
            font-weight: 800;
            padding: 14px 27px;
            border-radius: 7px;
            overflow: hidden;
            transition: .3s;
            box-shadow: 0 0 20px rgba(57,255,136,.2);
        }

        .btn-main:hover {
            transform: translateY(-4px);
            color: #000;
            box-shadow:
                0 0 15px var(--green),
                0 0 40px rgba(57,255,136,.35);
        }

        .btn-outline {
            border: 1px solid rgba(255,255,255,.15);
            color: white;
            padding: 14px 27px;
            border-radius: 7px;
            transition: .3s;
            background: rgba(255,255,255,.03);
        }

        .btn-outline:hover {
            border-color: var(--green);
            color: var(--green);
            background: rgba(57,255,136,.05);
            transform: translateY(-4px);
        }

        /* =========================
           FLOATING BLOCKS
        ========================= */

        .floating-block {
            position: absolute;
            width: 55px;
            height: 55px;
            background:
                linear-gradient(135deg, rgba(57,255,136,.2), rgba(57,255,136,.02));
            border: 1px solid rgba(57,255,136,.15);
            box-shadow: 0 0 30px rgba(57,255,136,.08);
            transform: rotate(45deg);
            animation: float 7s ease-in-out infinite;
        }

        .block-1 {
            right: 12%;
            top: 25%;
        }

        .block-2 {
            right: 25%;
            bottom: 20%;
            width: 35px;
            height: 35px;
            animation-delay: 2s;
        }

        .block-3 {
            left: 10%;
            bottom: 18%;
            width: 28px;
            height: 28px;
            animation-delay: 4s;
        }

        /* =========================
           PARTICLES
        ========================= */

        .particles {
            position: absolute;
            inset: 0;
            overflow: hidden;
            pointer-events: none;
        }

        .particle {
            position: absolute;
            width: 3px;
            height: 3px;
            background: var(--green);
            box-shadow: 0 0 10px var(--green);
            border-radius: 50%;
            animation: particleMove linear infinite;
            opacity: .5;
        }

        /* =========================
           SECTIONS
        ========================= */

        section {
            position: relative;
            padding: 110px 0;
        }

        .section-label {
            color: var(--green);
            text-transform: uppercase;
            font-size: 11px;
            letter-spacing: 4px;
            margin-bottom: 12px;
        }

        .section-title {
            font-size: clamp(30px, 5vw, 52px);
            font-weight: 800;
            margin-bottom: 18px;
        }

        .section-description {
            color: var(--muted);
            max-width: 650px;
            font-family: Arial, sans-serif;
            line-height: 1.7;
        }

        /* =========================
           GLASS CARDS
        ========================= */

        .glass-card {
            background: linear-gradient(
                145deg,
                rgba(20,35,27,.78),
                rgba(7,13,10,.72)
            );
            border: 1px solid var(--border);
            border-radius: 14px;
            backdrop-filter: blur(15px);
            transition: .4s;
            position: relative;
            overflow: hidden;
        }

        .glass-card::before {
            content: "";
            position: absolute;
            width: 100%;
            height: 1px;
            top: 0;
            left: -100%;
            background: linear-gradient(
                90deg,
                transparent,
                var(--green),
                transparent
            );
            transition: .7s;
        }

        .glass-card:hover::before {
            left: 100%;
        }

        .glass-card:hover {
            transform: translateY(-8px);
            border-color: rgba(57,255,136,.4);
            box-shadow:
                0 20px 60px rgba(0,0,0,.35),
                0 0 30px rgba(57,255,136,.06);
        }

        /* =========================
           SERVER STATUS
        ========================= */

        .status-card {
            padding: 30px;
        }

        .status-icon {
            width: 55px;
            height: 55px;
            display: grid;
            place-items: center;
            border-radius: 12px;
            background: rgba(57,255,136,.08);
            color: var(--green);
            font-size: 25px;
            box-shadow: inset 0 0 20px rgba(57,255,136,.04);
        }

        .status-number {
            font-size: 27px;
            font-weight: 800;
        }

        .status-small {
            color: var(--muted);
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        /* =========================
           FEATURES
        ========================= */

        .feature-card {
            padding: 32px;
            height: 100%;
        }

        .feature-icon {
            font-size: 35px;
            color: var(--green);
            text-shadow: 0 0 18px rgba(57,255,136,.45);
            margin-bottom: 25px;
        }

        .feature-card h4 {
            font-size: 18px;
        }

        .feature-card p {
            font-family: Arial, sans-serif;
            color: var(--muted);
            line-height: 1.7;
            margin: 0;
        }

        /* =========================
           RANKS
        ========================= */

        .rank-card {
            padding: 35px 25px;
            text-align: center;
        }

        .rank-icon {
            font-size: 45px;
            margin-bottom: 15px;
            color: var(--green);
            text-shadow: 0 0 20px rgba(57,255,136,.45);
        }

        .rank-price {
            font-size: 36px;
            font-weight: 900;
            margin: 18px 0;
        }

        .rank-price span {
            font-size: 12px;
            color: var(--muted);
        }

        .rank-list {
            list-style: none;
            padding: 0;
            text-align: left;
            margin: 25px 0;
        }

        .rank-list li {
            color: #aebbb3;
            font-family: Arial, sans-serif;
            padding: 9px 0;
            border-bottom: 1px solid rgba(255,255,255,.05);
        }

        .rank-list i {
            color: var(--green);
            margin-right: 8px;
        }

        .featured-rank {
            border-color: var(--green);
            box-shadow:
                0 0 35px rgba(57,255,136,.1),
                inset 0 0 40px rgba(57,255,136,.025);
            transform: translateY(-12px);
        }

        .popular {
            position: absolute;
            top: 15px;
            right: 15px;
            font-size: 9px;
            color: #031008;
            background: var(--green);
            padding: 6px 9px;
            border-radius: 4px;
            font-weight: 900;
        }

        /* =========================
           IP COPY
        ========================= */

        .ip-box {
            padding: 40px;
            text-align: center;
        }

        .server-ip {
            font-size: clamp(24px, 5vw, 48px);
            font-weight: 900;
            color: var(--green);
            text-shadow: 0 0 20px rgba(57,255,136,.45);
            letter-spacing: 2px;
        }

        .copy-btn {
            cursor: pointer;
        }

        /* =========================
           CTA
        ========================= */

        .cta {
            background:
                radial-gradient(
                    circle at center,
                    rgba(57,255,136,.1),
                    transparent 55%
                );
        }

        .cta-box {
            padding: 80px 30px;
            text-align: center;
            border: 1px solid rgba(57,255,136,.15);
            border-radius: 20px;
            background: rgba(10,18,14,.65);
            overflow: hidden;
            position: relative;
        }

        .cta-box h2 {
            font-size: clamp(30px, 5vw, 60px);
            font-weight: 900;
            text-shadow: 0 0 25px rgba(57,255,136,.25);
        }

        /* =========================
           FOOTER
        ========================= */

        footer {
            padding: 40px 0;
            border-top: 1px solid rgba(255,255,255,.06);
            color: #66766d;
            font-family: Arial, sans-serif;
        }

        footer strong {
            color: var(--green);
            font-family: "Orbitron", sans-serif;
        }

        /* =========================
           ANIMATIONS
        ========================= */

        @keyframes pulse {
            0%, 100% {
                box-shadow: 0 0 5px var(--green);
            }
            50% {
                box-shadow:
                    0 0 20px var(--green),
                    0 0 35px rgba(57,255,136,.4);
            }
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(0) rotate(45deg);
            }
            50% {
                transform: translateY(-30px) rotate(65deg);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        @keyframes particleMove {
            from {
                transform: translateY(110vh);
            }
            to {
                transform: translateY(-10vh);
            }
        }

        .reveal {
            opacity: 0;
            transform: translateY(35px);
            transition: 1s ease;
        }

        .reveal.active {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================
           MOBILE
        ========================= */

        @media (max-width: 768px) {
            .hero {
                text-align: center;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .featured-rank {
                transform: none;
            }

            section {
                padding: 80px 0;
            }

            .floating-block {
                opacity: .35;
            }
        }
    </style>
</head>

<body>

<!-- =========================
     NAVBAR
========================= -->

<nav class="navbar navbar-expand-lg navbar-dark fixed-top" id="navbar">

    <div class="container">

        <a class="navbar-brand" href="#">
            CRAFT<span>REALM</span>
        </a>

        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbarMenu"
        >
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMenu">

            <ul class="navbar-nav ms-auto align-items-lg-center">

                <li class="nav-item">
                    <a class="nav-link" href="#home">HOME</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#features">FEATURES</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#ranks">RANKS</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#status">SERVER</a>
                </li>

                <li class="nav-item ms-lg-3">
                    <a href="#play" class="btn btn-main btn-sm">
                        PLAY NOW
                    </a>
                </li>

            </ul>

        </div>

    </div>

</nav>


<!-- =========================
     HERO
========================= -->

<section class="hero" id="home">

    <div class="particles" id="particles"></div>

    <div class="floating-block block-1"></div>
    <div class="floating-block block-2"></div>
    <div class="floating-block block-3"></div>

    <div class="container hero-content">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <div class="badge-server">
                    <span class="online-dot"></span>
                    SERVER ONLINE
                </div>

                <h1>
                    BUILD.<br>
                    <span class="glow">SURVIVE.</span><br>
                    CONQUER.
                </h1>

                <p class="mt-4">
                    Enter a next-generation Minecraft experience.
                    Build your empire, explore dangerous worlds,
                    fight alongside your friends and create your own story.
                </p>

                <div class="d-flex gap-3 flex-wrap mt-4">

                    <a href="#play" class="btn btn-main">
                        <i class="bi bi-controller me-2"></i>
                        PLAY NOW
                    </a>

                    <a href="#features" class="btn btn-outline">
                        EXPLORE SERVER
                        <i class="bi bi-arrow-down ms-2"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     SERVER STATUS
========================= -->

<section id="status">

    <div class="container">

        <div class="text-center mb-5 reveal">

            <div class="section-label">
                SERVER STATUS
            </div>

            <h2 class="section-title">
                We're <span style="color:var(--green)">LIVE.</span>
            </h2>

            <p class="section-description mx-auto">
                Join thousands of players building their own Minecraft
                adventure on CraftRealm.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-md-4 reveal">

                <div class="glass-card status-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="status-icon">
                            <i class="bi bi-activity"></i>
                        </div>

                        <div>
                            <div class="status-number">
                                ONLINE
                            </div>

                            <div class="status-small">
                                Server Status
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4 reveal">

                <div class="glass-card status-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="status-icon">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <div class="status-number">
                                1,248
                            </div>

                            <div class="status-small">
                                Players Online
                            </div>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-md-4 reveal">

                <div class="glass-card status-card">

                    <div class="d-flex align-items-center gap-3">

                        <div class="status-icon">
                            <i class="bi bi-hdd-network"></i>
                        </div>

                        <div>
                            <div class="status-number">
                                24ms
                            </div>

                            <div class="status-small">
                                Average Ping
                            </div>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     FEATURES
========================= -->

<section id="features">

    <div class="container">

        <div class="row mb-5">

            <div class="col-lg-7 reveal">

                <div class="section-label">
                    WHY CRAFTREALM
                </div>

                <h2 class="section-title">
                    A WORLD BUILT<br>
                    <span style="color:var(--green)">FOR YOU.</span>
                </h2>

                <p class="section-description">
                    Everything you love about Minecraft, enhanced with
                    custom systems, exciting gameplay and a community
                    that never stops growing.
                </p>

            </div>

        </div>


        <div class="row g-4">

            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-globe2"></i>
                    </div>

                    <h4>Massive World</h4>

                    <p>
                        Explore a huge custom world filled with
                        secrets, structures, dungeons and unexplored
                        territory.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-lightning-charge"></i>
                    </div>

                    <h4>Fast Gameplay</h4>

                    <p>
                        Optimized infrastructure provides smooth
                        gameplay and low latency wherever you play.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-shield-check"></i>
                    </div>

                    <h4>Protected Builds</h4>

                    <p>
                        Advanced protection systems keep your
                        creations safe from griefers and unwanted
                        destruction.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-trophy"></i>
                    </div>

                    <h4>Custom Events</h4>

                    <p>
                        Participate in tournaments, seasonal events,
                        challenges and community competitions.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-gem"></i>
                    </div>

                    <h4>Economy</h4>

                    <p>
                        Build your fortune with a player-driven
                        economy, shops, trading and rare items.
                    </p>

                </div>

            </div>


            <div class="col-md-6 col-lg-4 reveal">

                <div class="glass-card feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-controller"></i>
                    </div>

                    <h4>Custom Modes</h4>

                    <p>
                        Jump between survival, factions, PvP,
                        minigames and unique custom experiences.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     RANKS
========================= -->

<section id="ranks">

    <div class="container">

        <div class="text-center mb-5 reveal">

            <div class="section-label">
                STORE
            </div>

            <h2 class="section-title">
                CHOOSE YOUR <span style="color:var(--green)">RANK.</span>
            </h2>

            <p class="section-description mx-auto">
                Upgrade your adventure and unlock exclusive perks.
            </p>

        </div>


        <div class="row g-4 align-items-center">

            <!-- VIP -->

            <div class="col-lg-4 reveal">

                <div class="glass-card rank-card">

                    <div class="rank-icon">
                        <i class="bi bi-star"></i>
                    </div>

                    <h3>VIP</h3>

                    <div class="rank-price">
                        $9.99
                        <span>/ month</span>
                    </div>

                    <ul class="rank-list">

                        <li>
                            <i class="bi bi-check"></i>
                            VIP chat prefix
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            2 extra homes
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Exclusive cosmetics
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Priority queue
                        </li>

                    </ul>

                    <button class="btn btn-outline w-100">
                        GET VIP
                    </button>

                </div>

            </div>


            <!-- MVP -->

            <div class="col-lg-4 reveal">

                <div class="glass-card rank-card featured-rank">

                    <div class="popular">
                        MOST POPULAR
                    </div>

                    <div class="rank-icon">
                        <i class="bi bi-gem"></i>
                    </div>

                    <h3>MVP</h3>

                    <div class="rank-price">
                        $19.99
                        <span>/ month</span>
                    </div>

                    <ul class="rank-list">

                        <li>
                            <i class="bi bi-check"></i>
                            Everything in VIP
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            5 extra homes
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Exclusive commands
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Special cosmetics
                        </li>

                    </ul>

                    <button class="btn btn-main w-100">
                        GET MVP
                    </button>

                </div>

            </div>


            <!-- LEGEND -->

            <div class="col-lg-4 reveal">

                <div class="glass-card rank-card">

                    <div class="rank-icon">
                        <i class="bi bi-fire"></i>
                    </div>

                    <h3>LEGEND</h3>

                    <div class="rank-price">
                        $39.99
                        <span>/ month</span>
                    </div>

                    <ul class="rank-list">

                        <li>
                            <i class="bi bi-check"></i>
                            Everything in MVP
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Unlimited homes
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Legendary cosmetics
                        </li>

                        <li>
                            <i class="bi bi-check"></i>
                            Maximum priority
                        </li>

                    </ul>

                    <button class="btn btn-outline w-100">
                        GET LEGEND
                    </button>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================
     PLAY SECTION
========================= -->

<section id="play">

    <div class="container">

        <div class="glass-card ip-box reveal">

            <div class="section-label">
                JOIN THE SERVER
            </div>

            <h2 class="section-title">
                YOUR ADVENTURE
                <span style="color:var(--green)">STARTS HERE.</span>
            </h2>

            <p class="section-description mx-auto mb-4">
                Copy the server address and jump into Minecraft.
            </p>

            <div class="server-ip mb-4" id="serverIP">
                play.craftrealm.net
            </div>

            <button class="btn btn-main copy-btn" onclick="copyIP()">
                <i class="bi bi-clipboard me-2"></i>
                COPY SERVER IP
            </button>

            <div
                id="copyMessage"
                class="mt-3"
                style="color:var(--green); display:none;"
            >
                Server IP copied!
            </div>

        </div>

    </div>

</section>


<!-- =========================
     CTA
========================= -->

<section class="cta">

    <div class="container">

        <div class="cta-box reveal">

            <div class="section-label">
                READY?
            </div>

            <h2>
                ENTER THE
                <span style="color:var(--green)">WORLD.</span>
            </h2>

            <p
                class="section-description mx-auto mt-3 mb-4"
            >
                Your next Minecraft adventure is waiting.
            </p>

            <a href="#play" class="btn btn-main">
                <i class="bi bi-controller me-2"></i>
                START PLAYING
            </a>

        </div>

    </div>

</section>


<!-- =========================
     FOOTER
========================= -->

